# Mẫu file secrets. COPY thành `secrets.properties` (đã gitignored) rồi điền giá trị thật.
#   cp secrets.properties.example secrets.properties
#
# Hoặc đặt trực tiếp qua biến môi trường khi chạy (ưu tiên trên production).

# Mật khẩu Postgres (Supabase).
DB_PASSWORD=

# OAuth client cho đăng nhập Google (Google Cloud Console -> Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# (Tùy chọn) ghi đè nếu khác mặc định:
# DB_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
# DB_USERNAME=postgres
